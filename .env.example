# Copy to .env locally. Do not commit .env or real credentials.
LLM_PROVIDER=generic_openai
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=16384
LLM_THINKING=disabled
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=2.0
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
RUN_REQUEST_INTERVAL_SECONDS=60
RUN_INITIAL_ATTEMPT_LIMIT=
RUN_RECOVERY_ATTEMPT_LIMIT=
RUN_TOTAL_ATTEMPT_LIMIT=
VALIDATOR_NETWORK_LOOKBEHIND=120
VALIDATOR_NETWORK_LOOKAHEAD=80
# E5 uses the user's normal Hugging Face cache, downloaded by prepare_embedding.py.
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
